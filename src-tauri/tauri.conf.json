{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuotaPulse",
  "version": "0.2.0",
  "identifier": "app.quotafloat.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "widget",
        "title": "QuotaPulse",
        "width": 100,
        "height": 100,
        "minWidth": 80,
        "minHeight": 80,
        "maxWidth": 420,
        "maxHeight": 560,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": true
      }
    ],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self'; img-src 'self' data:" }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": ["https://github.com/ChengruWu/QuotaPulse/releases/latest/download/latest.json"],
      "requireSignedVersion": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "category": "Utility",
    "shortDescription": "Codex and Gemini quota at a glance",
    "longDescription": "A lightweight Windows tray and floating monitor for Codex (GPT) and Antigravity (Gemini, Claude & GPT) usage limits.",
    "copyright": "Copyright QuotaPulse contributors",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
